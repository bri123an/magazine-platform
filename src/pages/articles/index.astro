---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Article, Category } from '../../lib/types';

interface Props {
  articles: Article[];
  categories: Category[];
  searchQuery?: string;
  selectedCategory?: string;
  sortBy?: 'newest' | 'oldest' | 'popular';
}

const { 
  articles, 
  categories, 
  searchQuery = '', 
  selectedCategory = '', 
  sortBy = 'newest' 
} = Astro.props;

const filteredArticles = articles
  .filter(article => {
    const matchesSearch = !searchQuery || 
      article.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
      article.excerpt.toLowerCase().includes(searchQuery.toLowerCase());
    const matchesCategory = !selectedCategory || article.category?.slug === selectedCategory;
    return matchesSearch && matchesCategory;
  })
  .sort((a, b) => {
    switch (sortBy) {
      case 'oldest':
        return new Date(a.publishedAt).getTime() - new Date(b.publishedAt).getTime();
      case 'popular':
        return (b.views || 0) - (a.views || 0);
      default:
        return new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime();
    }
  });
---

<BaseLayout title="Articles - Magazine" description="Browse all articles">
  <div class="container-custom mx-auto">
    {/* Filters */}
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <h1 class="text-3xl font-bold text-gray-900">Articles</h1>
      
      <div class="flex flex-wrap gap-4">
        <input
          type="text"
          placeholder="Search articles..."
          class="rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500"
          id="search-input"
        />
        
        <select 
          id="category-filter"
          class="rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500"
        >
          <option value="">All Categories</option>
          {categories.map(cat => (
            <option value={cat.slug}>{cat.name}</option>
          ))}
        </select>
        
        <select 
          id="sort-select"
          class="rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500"
        >
          <option value="newest">Newest First</option>
          <option value="oldest">Oldest First</option>
          <option value="popular">Most Popular</option>
        </select>
      </div>
    </div>

    {/* Articles List */}
    {filteredArticles.length > 0 ? (
      <div class="space-y-6">
        {filteredArticles.map(article => (
          <article class="card overflow-hidden">
            <a href={`/articles/${article.slug}`}>
              <div class="flex flex-col md:flex-row">
                {article.image && (
                  <img 
                    src={article.image} 
                    alt={article.title}
                    class="h-48 w-full md:h-auto md:w-48 md:shrink-0 object-cover"
                  />
                )}
                <div class="p-6">
                  <div class="mb-3 flex items-center gap-2">
                    {article.category && (
                      <span class="rounded-full bg-primary-100 px-3 py-1 text-xs font-medium text-primary-700">
                        {article.category.name}
                      </span>
                    )}
                    <span class="text-xs text-gray-500">
                      {new Date(article.publishedAt).toLocaleDateString()}
                    </span>
                  </div>
                  <h2 class="mb-2 text-xl font-semibold text-gray-900">{article.title}</h2>
                  <p class="text-sm text-gray-600">{article.excerpt}</p>
                  <div class="mt-3 flex items-center gap-4 text-sm text-gray-500">
                    {article.author && (
                      <span class="flex items-center gap-1">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        {article.author.name}
                      </span>
                    )}
                    <span>{article.readTime} min read</span>
                    {article.views && (
                      <span>{article.views} views</span>
                    )}
                  </div>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="py-12 text-center">
        <p class="text-gray-500">No articles found matching your criteria.</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  @keyframes slideIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  article {
    animation: slideIn 0.4s ease-out;
  }
</style>
