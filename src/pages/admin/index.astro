---
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Stats {
  totalArticles: number;
  totalAuthors: number;
  totalCategories: number;
  totalViews: number;
}

const stats: Stats = {
  totalArticles: 0,
  totalAuthors: 0,
  totalCategories: 0,
  totalViews: 0
};
---

<BaseLayout title="Admin Dashboard - Magazine" description="Manage your magazine platform">
  <div class="container-custom mx-auto">
    <h1 class="mb-8 text-3xl font-bold text-gray-900">Dashboard</h1>

    {/* Stats Grid */}
    <div class="mb-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <div class="card p-6">
        <div class="flex items-center gap-4">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-primary-100">
            <svg class="h-6 w-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2" />
            </svg>
          </div>
          <div>
            <p class="text-sm text-gray-600">Articles</p>
            <p class="text-2xl font-bold text-gray-900">{stats.totalArticles}</p>
          </div>
        </div>
      </div>

      <div class="card p-6">
        <div class="flex items-center gap-4">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-green-100">
            <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <div>
            <p class="text-sm text-gray-600">Authors</p>
            <p class="text-2xl font-bold text-gray-900">{stats.totalAuthors}</p>
          </div>
        </div>
      </div>

      <div class="card p-6">
        <div class="flex items-center gap-4">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-purple-100">
            <svg class="h-6 w-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 10h.01M7 13h.01M7 16h.01M12 7h.01M12 10h.01M12 13h.01M12 16h.01M17 7h.01M17 10h.01M17 13h.01M17 16h.01" />
            </svg>
          </div>
          <div>
            <p class="text-sm text-gray-600">Categories</p>
            <p class="text-2xl font-bold text-gray-900">{stats.totalCategories}</p>
          </div>
        </div>
      </div>

      <div class="card p-6">
        <div class="flex items-center gap-4">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-orange-100">
            <svg class="h-6 w-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9-9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
          </div>
          <div>
            <p class="text-sm text-gray-600">Total Views</p>
            <p class="text-2xl font-bold text-gray-900">{stats.totalViews.toLocaleString()}</p>
          </div>
        </div>
      </div>
    </div>

    {/* Quick Actions */}
    <div class="mb-8">
      <h2 class="mb-4 text-xl font-semibold text-gray-900">Quick Actions</h2>
      <div class="flex flex-wrap gap-4">
        <a href="/admin/articles" class="btn-primary">Manage Articles</a>
        <a href="/admin/authors" class="btn-primary" style="background-color: #16a34a;">Manage Authors</a>
        <a href="/admin/categories" class="btn-primary" style="background-color: #9333ea;">Manage Categories</a>
      </div>
    </div>

    {/* Recent Activity */}
    <div class="rounded-xl border border-gray-200 bg-white p-6">
      <h2 class="mb-4 text-xl font-semibold text-gray-900">Recent Activity</h2>
      <p class="text-gray-500">No recent activity to display.</p>
    </div>
  </div>
</BaseLayout>
