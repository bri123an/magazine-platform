---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Author, Article } from '../../lib/types';

interface Props {
  authors: Author[];
  featuredArticles: Article[];
}

const { authors, featuredArticles = [] } = Astro.props;
---

<BaseLayout title="Authors - Magazine" description="Meet our talented writers">
  <div class="container-custom mx-auto">
    <div class="mb-12 text-center">
      <h1 class="mb-4 text-4xl font-bold text-gray-900">Our Authors</h1>
      <p class="text-lg text-gray-600">Meet the talented writers behind our content</p>
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {authors.map(author => (
        <a href={`/authors/${author.slug}`} class="card group">
          <div class="p-8 text-center">
            <img 
              src={author.avatar || '/default-avatar.svg'} 
              alt={author.name}
              class="mx-auto mb-4 h-24 w-24 rounded-full object-cover ring-4 ring-gray-100"
            />
            <h2 class="mb-2 text-2xl font-semibold text-gray-900 group-hover:text-primary-600 transition-colors">
              {author.name}
            </h2>
            <p class="mb-4 text-gray-600">{author.bio || 'Contributing writer'}</p>
            <span class="text-sm font-medium text-primary-600">
              {author.articleCount} articles →
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
