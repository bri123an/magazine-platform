---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-gray-200 bg-white">
  <div class="container-custom mx-auto px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      <div class="md:col-span-2">
        <h3 class="text-lg font-semibold text-gray-900">Magazine</h3>
        <p class="mt-2 text-sm text-gray-600">
          A modern magazine platform built with cutting-edge web technologies.
        </p>
      </div>
      
      <div>
        <h4 class="text-sm font-semibold text-gray-900">Quick Links</h4>
        <ul class="mt-2 space-y-2 text-sm text-gray-600">
          <li><a href="/articles" class="hover:text-gray-900">Articles</a></li>
          <li><a href="/categories" class="hover:text-gray-900">Categories</a></li>
          <li><a href="/authors" class="hover:text-gray-900">Authors</a></li>
        </ul>
      </div>
      
      <div>
        <h4 class="text-sm font-semibold text-gray-900">Admin</h4>
        <ul class="mt-2 space-y-2 text-sm text-gray-600">
          <li><a href="/admin" class="hover:text-gray-900">Dashboard</a></li>
          <li><a href="/admin/articles" class="hover:text-gray-900">Manage Articles</a></li>
        </ul>
      </div>
    </div>
    
    <div class="mt-8 border-t border-gray-200 pt-8 text-center text-sm text-gray-500">
      <p>&copy; {currentYear} Magazine. All rights reserved.</p>
    </div>
  </div>
</footer>
